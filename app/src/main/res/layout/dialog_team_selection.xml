<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:maxHeight="600dp"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle & Title Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_badge_pill_inactive" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvTeamSelectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Team"
            android:textColor="@color/header_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseSelection"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_logout"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_grey" />

    <!-- Create New Team Primary Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateNewTeam"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="➕  Create New Team"
            android:textColor="@color/pure_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_red"
            app:cornerRadius="12dp"
            app:elevation="2dp" />
    </LinearLayout>

    <!-- Section Header: My Created Teams -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY CREATED TEAMS"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTeamsCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_pill_inactive"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="@color/header_dark_grey"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="3" />
    </LinearLayout>

    <!-- Empty State: No Teams Created Yet -->
    <LinearLayout
        android:id="@+id/layoutEmptyTeams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/border_grey" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No Teams Created Yet"
            android:textColor="@color/header_black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Create your own cricket teams to schedule matches and organize tournaments seamlessly."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyCreateFirstTeam"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:text="Create Your First Team"
            android:textColor="@color/primary_red"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary_red"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

    <!-- Recycler View for Teams List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTeamsSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:maxHeight="380dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        tools:itemCount="3"
        tools:listitem="@layout/item_team_selection" />
</LinearLayout>
