<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_white"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/header_black" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="12THMAN "
                    android:textColor="@color/header_black"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="GPT-1"
                    android:textColor="@color/primary_red"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Cricket AI • PyTorch Decoder"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Model Architecture Info Button -->
        <ImageView
            android:id="@+id/btnModelInfo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Model Architecture Info"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_info"
            app:tint="@color/header_black" />

        <!-- Clear Chat Button -->
        <ImageView
            android:id="@+id/btnClearChat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Reset Chat"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/header_black" />
    </LinearLayout>

    <!-- Model Stats Ribbon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D151515"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle_red" />

        <TextView
            android:id="@+id/tvModelRibbon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="910K Params • 4 Layers • Zero Pretrained Weights • Val Loss: 2.29"
            android:textColor="@color/header_black"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Prompt Suggestions Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipLbw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="What is LBW?"
                android:textColor="@color/header_black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipInswinger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Explain Inswinger"
                android:textColor="@color/header_black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipPowerplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="T20 Powerplay Rules"
                android:textColor="@color/header_black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipYorker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="What is a Yorker?"
                android:textColor="@color/header_black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipEconomy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Calculate Economy"
                android:textColor="@color/header_black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipTwelfthMan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Role of 12th Man"
                android:textColor="@color/header_black"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        tools:listitem="@layout/item_ai_chat_bot" />

    <!-- Thinking / Loading Indicator -->
    <LinearLayout
        android:id="@+id/layoutThinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/primary_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="12THMAN GPT-1 is analyzing cricket rules..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/light_grey"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Ask 12THMAN GPT-1 about cricket..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/header_black"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send Question"
            app:backgroundTint="@color/primary_red"
            app:elevation="2dp"
            app:fabCustomSize="44dp"
            app:srcCompat="@drawable/ic_send"
            app:tint="@color/pure_white" />
    </LinearLayout>
</LinearLayout>
