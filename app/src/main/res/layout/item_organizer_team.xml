<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_grey"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTeamLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_light"
                android:padding="8dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/primary_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTeamName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/header_black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Mumbai Strikers" />

                <TextView
                    android:id="@+id/tvTeamCaptain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Captain: Rohit Sharma • 15 Players" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTeamApprovalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_red_outline"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="APPROVED"
                android:textColor="@color/primary_red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivRemoveTeam"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayerListSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/header_dark_grey"
            android:textSize="12sp"
            tools:text="Players: Rohit S, Hardik P, Jasprit B, Suryakumar Y, Ishan K, Tilak V" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>