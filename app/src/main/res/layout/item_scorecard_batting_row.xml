<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minWidth="310dp"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Batter Name & Dismissal Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3.5"
        android:minWidth="120dp"
        android:orientation="vertical"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvRowBatterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Virat Kohli*"
            android:textColor="@color/header_black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRowBatterDismissal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="not out"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Runs (R) -->
    <TextView
        android:id="@+id/tvRowBatterR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:minWidth="32dp"
        android:text="48"
        android:textColor="@color/header_black"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Balls (B) -->
    <TextView
        android:id="@+id/tvRowBatterB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:minWidth="32dp"
        android:text="32"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Fours (4s) -->
    <TextView
        android:id="@+id/tvRowBatter4s"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:minWidth="32dp"
        android:text="5"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Sixes (6s) -->
    <TextView
        android:id="@+id/tvRowBatter6s"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:minWidth="32dp"
        android:text="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Strike Rate (SR) -->
    <TextView
        android:id="@+id/tvRowBatterSR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:gravity="end"
        android:minWidth="44dp"
        android:text="150.0"
        android:textColor="@color/header_black"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
