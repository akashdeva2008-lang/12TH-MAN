<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@color/surface_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <!-- Rank / Position -->
    <TextView
        android:id="@+id/tvStandingPos"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/header_black"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="1" />

    <!-- Team Name -->
    <TextView
        android:id="@+id/tvStandingTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/header_black"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Red Warriors" />

    <!-- Played (P) -->
    <TextView
        android:id="@+id/tvStandingP"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="3" />

    <!-- Won (W) -->
    <TextView
        android:id="@+id/tvStandingW"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/accent_green"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="3" />

    <!-- Lost (L) -->
    <TextView
        android:id="@+id/tvStandingL"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/primary_red"
        android:textSize="12sp"
        tools:text="0" />

    <!-- Points (PTS) -->
    <TextView
        android:id="@+id/tvStandingPts"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/header_black"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="6" />

    <!-- Net Run Rate (NRR) -->
    <TextView
        android:id="@+id/tvStandingNrr"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/header_dark_grey"
        android:textSize="12sp"
        tools:text="+1.420" />
</LinearLayout>