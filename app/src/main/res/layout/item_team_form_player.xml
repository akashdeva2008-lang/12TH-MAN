<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_search_box"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Jersey Number Badge -->
    <TextView
        android:id="@+id/tvPlayerJersey"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_badge_pill_inactive"
        android:gravity="center"
        android:textColor="@color/header_dark_grey"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="#18" />

    <!-- Player Name & Role -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlayerItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/header_black"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Virat Kohli" />

            <TextView
                android:id="@+id/tvCaptainBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_red"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="(C)"
                android:textColor="@color/pure_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayerItemRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/primary_red"
            android:textSize="11sp"
            tools:text="Batsman • +91 98765 43210" />
    </LinearLayout>

    <!-- Remove Player Button -->
    <ImageView
        android:id="@+id/btnRemovePlayer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Remove Player"
        android:focusable="true"
        android:padding="5dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_secondary" />
</LinearLayout>
