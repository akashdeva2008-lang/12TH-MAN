<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <!-- Top App Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/top_bar_dark_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Matches"
            android:textColor="@color/pure_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivMatchSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Search"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            app:tint="@color/pure_white" />

        <ImageView
            android:id="@+id/ivMatchFilter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Filter"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_filter"
            app:tint="@color/pure_white" />
    </LinearLayout>

    <!-- Tab Filter Pills Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- Upcoming Tab (Active) -->
        <TextView
            android:id="@+id/tabUpcoming"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pill_active"
            android:gravity="center"
            android:text="Upcoming"
            android:textColor="@color/pure_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Live Tab -->
        <TextView
            android:id="@+id/tabLive"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pill_inactive"
            android:gravity="center"
            android:text="Live"
            android:textColor="@color/header_dark_grey"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Completed Tab -->
        <TextView
            android:id="@+id/tabCompleted"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pill_inactive"
            android:gravity="center"
            android:text="Completed"
            android:textColor="@color/header_dark_grey"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Matches RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatchFixtures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        tools:listitem="@layout/item_match" />
</LinearLayout>
