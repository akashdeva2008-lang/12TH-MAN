<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TwelveMan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color Scheme -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/primary_navy</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/primary_navy</item>
        <item name="colorTertiary">@color/accent_blue</item>
        <item name="colorOnTertiary">@color/text_white</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:navigationBarColor">@color/primary_navy</item>
        <item name="android:windowBackground">@color/bg_light</item>

        <!-- Typography & Text Styling -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.TwelveMan.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.TwelveMan.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.TwelveMan.TitleLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.TwelveMan.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.TwelveMan.BodyMedium</item>
    </style>

    <!-- Custom High-Legibility Typography Styles -->
    <style name="TextAppearance.TwelveMan.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_hero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.TwelveMan.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.TwelveMan.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.TwelveMan.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.TwelveMan.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>